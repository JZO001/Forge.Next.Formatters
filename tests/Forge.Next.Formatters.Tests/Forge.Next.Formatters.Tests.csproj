<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<RootNamespace>Forge.Next.Formatters.Tests</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- The Brotli formatters do not exist on net48 (System.IO.Compression.Brotli is not available there). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Compile Remove="BrotliByteArrayFormatterTests.cs" />
		<Compile Remove="BrotliStreamFormatterTests.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="NSubstitute" Version="6.2.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Forge.Next.Formatters\Forge.Next.Formatters.csproj" />
	</ItemGroup>

</Project>
